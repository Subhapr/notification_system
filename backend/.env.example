# =====================================================
# DJANGO CORE
# =====================================================
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave empty to use local SQLite for development.
# In production (Render) this will be a full Postgres URL, e.g.
# postgres://user:password@host:5432/dbname
DATABASE_URL=

# =====================================================
# JWT
# =====================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =====================================================
# WHATSAPP CONFIGURATION (Meta WhatsApp Cloud API sandbox)
# Paste your sandbox credentials into these environment variables.
# NEVER hardcode credentials in source files.
# Obtain from: https://developers.facebook.com/apps -> your app -> WhatsApp -> API Setup
# =====================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# =====================================================
# EMAIL CONFIGURATION
# EMAIL_PROVIDER selects which adapter the engine uses (postmark | console)
# "console" is a safe local-dev mode that just logs emails - no real sending.
# =====================================================
EMAIL_PROVIDER=console
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# =====================================================
# ONESIGNAL (Web Push) CONFIGURATION
# Obtain from: https://onesignal.com -> App Settings -> Keys & IDs
# =====================================================
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# =====================================================
# SITE / MISC
# =====================================================
SITE_NAME=NotifyHub
